# MongoDB Connection URI (Keep private in your real .env file)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/BusFee

# JWT Secret for securing token verification and payloads
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Application Port
PORT=3000

# Runtime Environment Setting
NODE_ENV=development

# Gemini API Key (Automatically injected by AI Studio at runtime)
GEMINI_API_KEY=your_gemini_api_key_here

# App Host URL
APP_URL=http://localhost:3000
